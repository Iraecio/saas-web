{
  "name": "saas-web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "ng serve --proxy-config proxy.conf.json --configuration development",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "serve:ssr": "node dist/saas-web/server/server.mjs",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\""
  },
  "private": true,
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.0",
    "@lucide/angular": "^1.67.0",
    "@types/three": "^0.184.0",
    "express": "^5.1.0",
    "primeicons": "^7.0.0",
    "primeng": "^22.1.4",
    "rxjs": "~7.8.0",
    "three": "^0.184.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vercel/node": "^3.0.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.10",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
