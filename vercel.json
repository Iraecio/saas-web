{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/saas-web/browser",
  "functions": {
    "api/handler.ts": {
      "maxDuration": 60,
      "includeFiles": "dist/saas-web/server/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/handler"
    }
  ]
}
